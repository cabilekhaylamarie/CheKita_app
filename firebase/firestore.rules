rules_version = '2';

// CheKita — every document lives under users/{uid}. A signed-in user can only read and
// write their own profile and their own products, materials, production records,
// sales and reports. Photos are small base64 thumbnails inside these documents,
// so no Firebase Storage rules are needed.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasId(docId) {
      return request.resource.data.id is string && request.resource.data.id == docId;
    }

    // Keep thumbnails small so a document can never blow past Firestore's 1 MB limit.
    function thumbnailIsSmall() {
      return !('imageData' in request.resource.data)
        || request.resource.data.imageData == null
        || request.resource.data.imageData.size() < 400000;
    }

    // Profile: users/{uid}
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && (!('email' in request.resource.data) || request.resource.data.email is string)
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && (!('avatarData' in request.resource.data)
            || request.resource.data.avatarData == null
            || request.resource.data.avatarData.size() < 400000);

      // Products — ingredients and labor/overhead are arrays inside the product
      match /products/{productId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasId(productId) && thumbnailIsSmall()
          && request.resource.data.name is string
          && request.resource.data.stock is int
          && request.resource.data.ingredients is list
          && (!('overheads' in request.resource.data)
              || request.resource.data.overheads == null
              || request.resource.data.overheads is list);
      }

      // Inventory materials
      match /materials/{materialId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasId(materialId) && thumbnailIsSmall()
          && request.resource.data.name is string
          && request.resource.data.cost is number
          && request.resource.data.currentStock is number;
      }

      // Production records
      match /productionRecords/{recordId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasId(recordId) && thumbnailIsSmall()
          && request.resource.data.quantity is int
          && request.resource.data.lines is list;
      }

      // Sales
      match /sales/{saleId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasId(saleId) && thumbnailIsSmall()
          && request.resource.data.quantity is int
          && request.resource.data.quantity > 0
          && request.resource.data.unitPrice is number
          && request.resource.data.unitPrice >= 0
          && request.resource.data.unitCost is number;
      }

      // Aggregated reports (users/{uid}/reports/summary)
      match /reports/{reportId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
